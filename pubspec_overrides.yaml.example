dependency_overrides:
  optional_features:
    git:
      url: git@github.com:avdept/optional_features.git
      ref: main
  # This file replaces the dependency_overrides section of pubspec.yaml, so
  # the vendored audio_session and audio_service forks have to be repeated here.
  audio_session:
    path: ./packages/audio_session
  audio_service:
    path: ./packages/audio_service
