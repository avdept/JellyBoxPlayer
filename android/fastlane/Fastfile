require "base64"
require "fileutils"

default_platform(:android)

PROJECT_ROOT = File.expand_path("../..", __dir__)
ANDROID_ROOT = File.join(PROJECT_ROOT, "android")
KEY_PROPERTIES_PATH = File.join(ANDROID_ROOT, "key.properties")
UPLOAD_KEYSTORE_PATH = File.join(ANDROID_ROOT, "upload_key.jks")
AAB_PATH = File.join(PROJECT_ROOT, "build/app/outputs/bundle/release/app-release.aab")
FLUTTER_APK_PATH = File.join(PROJECT_ROOT, "build/app/outputs/flutter-apk/app-release.apk")
UNIVERSAL_APK_PATH = File.join(PROJECT_ROOT, "build/app/outputs/universal/jellybox-universal.apk")
PLAY_TRACKS = %w[internal alpha beta production].freeze

def create_upload_key
  if ENV["ANDROID_KEYSTORE_ENV_VAR"].to_s.empty?
    UI.user_error!("ANDROID_KEYSTORE_ENV_VAR is unset and android/key.properties does not exist") unless File.exist?(KEY_PROPERTIES_PATH)
    UI.message("Signing with the existing android/key.properties")
    return
  end

  File.binwrite(UPLOAD_KEYSTORE_PATH, Base64.decode64(ENV["ANDROID_KEYSTORE_ENV_VAR"])) unless File.exist?(UPLOAD_KEYSTORE_PATH)

  File.write(KEY_PROPERTIES_PATH, <<~PROPERTIES)
    storeFile=#{UPLOAD_KEYSTORE_PATH}
    storePassword=#{ENV['ANDROID_KEYSTORE_PASSWORD']}
    keyPassword=#{ENV['ANDROID_KEYSTORE_PASSWORD']}
    keyAlias=#{ENV['ANDROID_KEY_ALIAS']}
  PROPERTIES

  UI.message("Wrote key.properties for keystore #{UPLOAD_KEYSTORE_PATH} (#{File.size(UPLOAD_KEYSTORE_PATH)} bytes)")
end

def play_package_name
  ENV["PACKAGE_NAME"].to_s.empty? ? "com.prodigytech.jellybox" : ENV["PACKAGE_NAME"]
end

def play_track
  ENV["PLAY_TRACK"].to_s.empty? ? "internal" : ENV["PLAY_TRACK"]
end

def pubspec_version_code
  match = File.read(File.join(PROJECT_ROOT, "pubspec.yaml")).match(/^version:\s*\S+\+(\d+)\s*$/)
  UI.user_error!("Could not parse a version code out of pubspec.yaml") if match.nil?
  match[1].to_i
end

def highest_play_version_code
  codes = PLAY_TRACKS.flat_map do |track|
    begin
      google_play_track_version_codes(
        package_name: play_package_name,
        track: track,
        json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"]
      )
    rescue StandardError => e
      UI.verbose("No version codes readable for track '#{track}': #{e.message.strip}")
      []
    end
  end

  codes.map(&:to_i).max
end

def resolve_version_code
  return ENV["BUILD_NUMBER"].to_i unless ENV["BUILD_NUMBER"].to_s.empty?

  highest = highest_play_version_code
  if highest.nil?
    UI.message("Play reports no existing version codes; falling back to pubspec.yaml")
    return pubspec_version_code
  end

  resolved = [highest + 1, pubspec_version_code].max
  UI.message("Highest version code on Play is #{highest}; using #{resolved}")
  resolved
end

def version_args(version_code)
  args = []
  args << "--build-name=#{ENV['BUILD_VERSION']}" unless ENV["BUILD_VERSION"].to_s.empty?
  args << "--build-number=#{version_code}"
  args.join(" ")
end

def build_appbundle(version_code)
  create_upload_key

  Dir.chdir(PROJECT_ROOT) do
    sh("flutter pub get")
    sh("flutter build appbundle --release #{version_args(version_code)}")
  end

  UI.user_error!("Expected an app bundle at #{AAB_PATH}") unless File.exist?(AAB_PATH)
end

def build_universal_apk(version_code)
  create_upload_key

  Dir.chdir(PROJECT_ROOT) do
    sh("flutter build apk --release #{version_args(version_code)}")
  end

  UI.user_error!("Expected an APK at #{FLUTTER_APK_PATH}") unless File.exist?(FLUTTER_APK_PATH)

  FileUtils.mkdir_p(File.dirname(UNIVERSAL_APK_PATH))
  FileUtils.cp(FLUTTER_APK_PATH, UNIVERSAL_APK_PATH)

  UNIVERSAL_APK_PATH
end

platform :android do
  desc "Build a signed app bundle and universal APK, and upload the bundle to Play as a draft"
  lane :beta do
    version_code = resolve_version_code
    UI.important("Building version code #{version_code}")

    build_appbundle(version_code)
    apk = build_universal_apk(version_code)
    UI.success("Universal APK ready at #{apk}")

    upload_to_play_store(
      package_name: play_package_name,
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      aab: AAB_PATH,
      track: play_track,
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build a signed app bundle and APK locally without uploading anywhere"
  lane :build_only do
    version_code = ENV["BUILD_NUMBER"].to_s.empty? ? pubspec_version_code : ENV["BUILD_NUMBER"].to_i

    build_appbundle(version_code)
    apk = build_universal_apk(version_code)
    UI.success("Universal APK ready at #{apk}")
  end
end
